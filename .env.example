# Copy to .env to override the defaults used by compose.yaml.
# The defaults are short so a demo run takes about 30 seconds.
# For the real Cloudflare numbers use EDGE_READ_TIMEOUT=100 and AGENT_DURATION=130.

# Seconds the edge proxy waits for the next byte from the upstream before it gives up
# (like Cloudflare's 100-second limit, which ends in a 524).
EDGE_READ_TIMEOUT=15

# Default total run time of the simulated agent, in seconds (can be changed on the page).
# 80% of it is one long step with no output.
AGENT_DURATION=30

# Seconds between `: ping` comments, for the simulated upstream that sends keep-alives.
# A real provider picks this, not you. Dify Cloud, for example, sends one about every
# 10 seconds; a self-hosted Dify may differ.
HEARTBEAT_INTERVAL=5

# Seconds between `step_progress` events when the caller turns on progress streaming.
PROGRESS_INTERVAL=4

# Port on the host where the demo page is served.
PUBLIC_PORT=8000
